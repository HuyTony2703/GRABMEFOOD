diff --git a/v2/scripts/build-bounded.ps1 b/v2/scripts/build-bounded.ps1
new file mode 100644
index 0000000..8913159
--- /dev/null
+++ b/v2/scripts/build-bounded.ps1
@@ -0,0 +1,38 @@
+param(
+    [Parameter(Mandatory = $true)][string]$DockerDataPath,
+    [Parameter(Mandatory = $true)][string]$RunId
+)
+$ErrorActionPreference = 'Stop'
+if ($RunId -notmatch '^[a-z0-9-]+$') { throw 'Invalid run identifier.' }
+$root = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
+$images = Get-Content (Join-Path $root 'infra/image-proposal.json') -Raw | ConvertFrom-Json
+$profile = Get-Content (Join-Path $root 'infra/demo-lite.json') -Raw | ConvertFrom-Json
+if ($images.status -ne 'owner-approved' -or $profile.status -ne 'owner-approved') { throw 'Approval missing.' }
+$nodes = @(Get-CimInstance Win32_Process -Filter "Name='node.exe'")
+if ($nodes.Count -gt 0) { throw 'Windows Node processes present: classify/stop duplicates explicitly before this controlled build.' }
+$preflight = & (Join-Path $PSScriptRoot 'preflight.ps1') -DockerDataPath $DockerDataPath -Profile demo-lite -Phase build | ConvertFrom-Json
+if ($LASTEXITCODE -ne 0 -or $preflight.status -ne 'pass') { throw 'Budget preflight blocked.' }
+$running = @(& docker ps --quiet)
+if ($LASTEXITCODE -ne 0 -or $running.Count -gt 0) { throw 'Controlled build requires no running containers; no existing containers were stopped.' }
+$output = Join-Path $root "reports/$RunId"
+if (Test-Path -LiteralPath $output) { throw 'Run output exists; refusing overwrite.' }
+New-Item -ItemType Directory -Path $output | Out-Null
+$preflight | ConvertTo-Json -Depth 8 | Set-Content (Join-Path $output 'preflight.json') -Encoding UTF8
+$reference = "$($images.node.reference)@$($images.node.indexDigest)"
+& docker pull --platform linux/amd64 $reference
+if ($LASTEXITCODE -ne 0) { throw 'Approved Node image pull failed.' }
+$name = "gmf64-build-$RunId"
+$cap = "$($profile.budget.buildContainerMiB)m"
+& docker run --detach --name $name --label io.grabmefood.task=SCRUM-64 --platform linux/amd64 --memory $cap --memory-swap $cap --cpus 2 --mount "type=bind,source=$root,target=/source,readonly" $reference bash /source/scripts/build-bounded.sh | Out-Null
+if ($LASTEXITCODE -ne 0) { throw 'Bounded build container did not start.' }
+& (Join-Path $PSScriptRoot 'measure-local.ps1') -Container $name -OutputDirectory $output
+Start-Process -FilePath docker -ArgumentList @('logs', $name) -Wait -NoNewWindow -RedirectStandardOutput (Join-Path $output 'build.stdout.log') -RedirectStandardError (Join-Path $output 'build.stderr.log')
+$state = (& docker inspect --format '{{json .State}}' $name) | ConvertFrom-Json
+$state | Select-Object Status,ExitCode,OOMKilled,Error,StartedAt,FinishedAt | ConvertTo-Json | Set-Content (Join-Path $output 'state.json') -Encoding UTF8
+if ($state.ExitCode -ne 0 -or $state.OOMKilled) { throw "Bounded build failed; inspect reports/$RunId/build.stdout.log and build.stderr.log. No retry/cap reduction or cleanup attempted." }
+$artifacts = Join-Path $root "reports/runtime-artifacts-$RunId"
+New-Item -ItemType Directory -Path $artifacts | Out-Null
+& docker cp "${name}:/artifacts/." $artifacts
+if ($LASTEXITCODE -ne 0) { throw 'Cannot export Linux tar artifacts.' }
+$artifacts | Set-Content (Join-Path $output 'artifact-path.txt') -Encoding UTF8
+Write-Output "Bounded build complete; artifacts: $artifacts . Test container retained stopped; no data deleted."
diff --git a/v2/scripts/build-bounded.sh b/v2/scripts/build-bounded.sh
new file mode 100644
index 0000000..31de4bf
--- /dev/null
+++ b/v2/scripts/build-bounded.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+set -euo pipefail
+trap 'printf "CGROUP_PEAK_BYTES="; cat /sys/fs/cgroup/memory.peak; printf "CGROUP_EVENTS="; cat /sys/fs/cgroup/memory.events' EXIT
+node -e 'const f=require("fs"); const s=f.readFileSync("/proc/meminfo","utf8"); const k=Number(s.match(/^MemAvailable:\s+(\d+)/m)[1]); console.log("LINUX_MEMAVAILABLE_KIB="+k); if(k<3328*1024) process.exit(2); console.log("CGROUP_MAX="+f.readFileSync("/sys/fs/cgroup/memory.max","utf8").trim()); console.log("CGROUP_SWAP_MAX="+f.readFileSync("/sys/fs/cgroup/memory.swap.max","utf8").trim())'
+mkdir -p /workspace /artifacts
+# Explicit source allowlist; never copy host deps/build caches or environment files.
+tar -C /source --exclude=node_modules --exclude=.next --exclude=dist --exclude=.pnpm-store \
+  --exclude='*.tsbuildinfo' --exclude='.env*' -cf - \
+  package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json apps services packages |
+  tar -C /workspace -xf -
+cd /workspace
+npm install --prefix /opt/pnpm --ignore-scripts --no-audit --no-fund pnpm@11.5.0
+export PATH="/opt/pnpm/node_modules/.bin:$PATH"
+export CI=true npm_config_ignore_scripts=true
+export NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=768 RAYON_NUM_THREADS=1 UV_THREADPOOL_SIZE=2
+pnpm install --frozen-lockfile --ignore-scripts
+pnpm -r --workspace-concurrency=1 build
+deployRoot="/deploy/attempt-$(date -u +%Y%m%dT%H%M%S%N)"
+test ! -e "$deployRoot"
+mkdir -p "$deployRoot"
+for service in gateway catalog community notification; do
+  pnpm --config.ignore-scripts=true --filter "@grabmefood/$service" deploy --prod --legacy "$deployRoot/$service"
+  test -f "$deployRoot/$service/dist/main.js"
+  tar -C "$deployRoot/$service" -cf "/artifacts/$service.tar" .
+done
+test -f apps/web/.next/standalone/apps/web/server.js
+cp -a apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static
+tar -C apps/web/.next/standalone -cf /artifacts/web.tar .
+cp /source/scripts/container-liveness.mjs /artifacts/container-liveness.mjs
+echo BOUNDED_BUILD_COMPLETE
diff --git a/v2/scripts/container-liveness.mjs b/v2/scripts/container-liveness.mjs
new file mode 100644
index 0000000..f193607
--- /dev/null
+++ b/v2/scripts/container-liveness.mjs
@@ -0,0 +1,15 @@
+// Container health is process liveness ONLY, not Cloud/business readiness.
+const port = Number(process.env.PORT);
+const path = process.env.HEALTH_PATH;
+if (!Number.isInteger(port) || port < 1024 || port > 65535 ||
+    !['/health/live', '/api/health/live'].includes(path)) {
+  process.exitCode = 1;
+} else {
+  try {
+    const response = await fetch(`http://127.0.0.1:${port}${path}`, { signal: AbortSignal.timeout(2000) });
+    const body = await response.json();
+    if (response.status !== 200 || body.status !== 'alive' || body.scope !== 'scaffold') process.exitCode = 1;
+  } catch {
+    process.exitCode = 1;
+  }
+}
diff --git a/v2/scripts/measure-local.ps1 b/v2/scripts/measure-local.ps1
new file mode 100644
index 0000000..a554ce2
--- /dev/null
+++ b/v2/scripts/measure-local.ps1
@@ -0,0 +1,44 @@
+param(
+    [Parameter(Mandatory = $true)][string]$Container,
+    [Parameter(Mandatory = $true)][string]$OutputDirectory,
+    [int]$MaxSeconds = 900
+)
+$ErrorActionPreference = 'Stop'
+$start = Get-Date
+$measurements = @()
+$aborted = $false
+do {
+    $stateText = & docker inspect --format '{{json .State}}' $Container
+    if ($LASTEXITCODE -ne 0) { throw 'Cannot inspect exact test container.' }
+    $state = $stateText | ConvertFrom-Json
+    $os = Get-CimInstance Win32_OperatingSystem
+    $vm = @(Get-Process -Name '*vmmem*' -ErrorAction SilentlyContinue)
+    $stats = & docker stats --no-stream --format '{{json .}}' $Container 2>$null
+    $measurements += [pscustomobject]@{
+        At=(Get-Date -Format o)
+        AvailableMiB=$os.FreePhysicalMemory/1024
+        VmWorkingSetMiB=($vm | Measure-Object WorkingSet64 -Sum).Sum/1MB
+        ContainerStats=($stats -join '')
+        Status=$state.Status
+        OOMKilled=$state.OOMKilled
+    }
+    if (-not $state.Running) { break }
+    if ($os.FreePhysicalMemory/1024 -lt 1024 -or ((Get-Date)-$start).TotalSeconds -gt $MaxSeconds) {
+        $aborted = $true
+        # Safety stop is scoped to our named experimental container, never host apps/data.
+        & docker stop --timeout 30 $Container | Out-Null
+        break
+    }
+    Start-Sleep -Seconds 1
+} while ($true)
+$measurements | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $OutputDirectory 'measurements.json') -Encoding UTF8
+$summary = [pscustomobject]@{
+    Container=$Container
+    Samples=$measurements.Count
+    MinWindowsAvailableMiB=($measurements | Measure-Object AvailableMiB -Minimum).Minimum
+    MaxVmWorkingSetMiB=($measurements | Measure-Object VmWorkingSetMiB -Maximum).Maximum
+    Aborted=$aborted
+}
+$summary | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $OutputDirectory 'summary.json') -Encoding UTF8
+$summary | Format-List
+if ($aborted) { throw 'Budget safety stop: host reserve or experiment timeout exceeded.' }
diff --git a/v2/scripts/preflight-policy.mjs b/v2/scripts/preflight-policy.mjs
new file mode 100644
index 0000000..ae2c6fc
--- /dev/null
+++ b/v2/scripts/preflight-policy.mjs
@@ -0,0 +1,89 @@
+import { pathToFileURL } from 'node:url';
+import { readFileSync } from 'node:fs';
+import { parseArgs } from 'node:util';
+
+const demoLite = JSON.parse(readFileSync(new URL('../infra/demo-lite.json', import.meta.url), 'utf8'));
+
+// Approved provisional host guards, not measured full-workload guarantees.
+export const thresholds = Object.freeze({
+  usableRamGiB: 15, freeRamGiB: 6, dockerDataFreeGiB: 15, workspaceFreeGiB: 10,
+});
+export const localPorts = Object.freeze([3000, 3001, 3002, 3003, 3004, 5672, 15672]);
+
+export function evaluatePreflight(input, { profile = 'full', phase = 'build' } = {}) {
+  if (!['full', 'demo-lite'].includes(profile) || !['build', 'runtime'].includes(phase)) {
+    throw new Error('Unsupported preflight profile or phase');
+  }
+  if (profile === 'demo-lite' && demoLite.status !== 'owner-approved') {
+    throw new Error('Profile approval missing');
+  }
+  const budget = demoLite.budget;
+  const requiredMiB = profile === 'demo-lite'
+    ? budget.windowsReserveMiB + budget.incrementalVmAllowanceMiB +
+      (phase === 'build' ? budget.buildContainerMiB : budget.runtimeContainersMiB)
+    : thresholds.freeRamGiB * 1024;
+  const selectedThresholds = {
+    ...thresholds,
+    freeRamGiB: requiredMiB / 1024,
+  };
+  const checks = [];
+  for (const [name, minimum] of Object.entries(selectedThresholds)) {
+    const actual = input[name];
+    checks.push({
+      name, minimum, actual: Number.isFinite(actual) && actual >= 0 ? actual : null,
+      status: !Number.isFinite(actual) || actual < 0 ? 'unknown' : actual >= minimum ? 'pass' : 'blocked',
+    });
+  }
+  checks.push({ name: 'dockerEngine', status: input.dockerEngineReachable === true ? 'pass' : 'blocked' });
+  checks.push({ name: 'dockerLinux', status: input.dockerOsType === 'linux' ? 'pass' : 'blocked' });
+  checks.push({ name: 'compose', status: input.composeAvailable === true ? 'pass' : 'blocked' });
+  if (profile === 'demo-lite') {
+    const minimum = (phase === 'build' ? budget.buildContainerMiB : budget.runtimeContainersMiB) + budget.incrementalVmAllowanceMiB;
+    checks.push({ name: 'dockerVmCapacityMiB', minimum,
+      actual: Number.isFinite(input.dockerMemoryMiB) ? input.dockerMemoryMiB : null,
+      status: Number.isFinite(input.dockerMemoryMiB) && input.dockerMemoryMiB >= minimum ? 'pass' : 'blocked',
+      scope: 'VM capacity only, not Windows available or Linux MemAvailable' });
+  }
+  for (const port of localPorts) {
+    checks.push({ name: `port:${port}`, status: input.ports?.[port] === true ? 'pass' : 'blocked' });
+  }
+  return {
+    scope: 'local-host-only',
+    profile,
+    phase,
+    status: checks.every(check => check.status === 'pass') ? 'pass' : 'blocked',
+    checks,
+    cloud: { status: 'not-verified', reason: 'No Cloud calls, credentials, quotas or TLS probes in this check.' },
+    imageApproval: 'separate-owner-gate',
+    ...(profile === 'demo-lite' ? {
+      budget: { requiredAvailableMiB: requiredMiB, windowsReserveMiB: budget.windowsReserveMiB,
+        incrementalVmAllowanceMiB: budget.incrementalVmAllowanceMiB,
+        workloadCapMiB: phase === 'build' ? budget.buildContainerMiB : budget.runtimeContainersMiB,
+        swapAsRam: false, buildMode: 'single-capped-linux-container' },
+      containerLimits: { status: 'declared-not-runtime-verified', memoryMiB: { ...demoLite.containerMemoryMiB } },
+    } : {}),
+    note: 'Point-in-time preflight only; not application readiness or permission to pull/start.',
+  };
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  try {
+    let text = '';
+    for await (const chunk of process.stdin) text += chunk;
+    const { values } = parseArgs({
+      options: {
+        profile: { type: 'string', default: 'full' },
+        phase: { type: 'string', default: 'build' },
+      },
+      strict: true,
+      allowPositionals: false,
+    });
+    const report = evaluatePreflight(JSON.parse(text), values);
+    console.log(JSON.stringify(report, null, 2));
+    process.exitCode = report.status === 'pass' ? 0 : 2;
+  } catch {
+    // Never echo arbitrary input or raw tool output.
+    console.error('Preflight input invalid; no startup was attempted.');
+    process.exitCode = 2;
+  }
+}
diff --git a/v2/scripts/preflight.ps1 b/v2/scripts/preflight.ps1
new file mode 100644
index 0000000..2a1b1d5
--- /dev/null
+++ b/v2/scripts/preflight.ps1
@@ -0,0 +1,71 @@
+param(
+    # Owner supplies the EXISTING Windows directory backing Docker Desktop data.
+    # Never infer this from Linux /var/lib/docker or read Desktop account settings.
+    [string]$DockerDataPath,
+    [ValidateSet('full', 'demo-lite')]
+    [string]$Profile = 'full',
+    [ValidateSet('build', 'runtime')]
+    [string]$Phase = 'build'
+)
+
+$ErrorActionPreference = 'Stop'
+$workspace = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
+$measurement = @{
+    dockerEngineReachable = $false
+    dockerOsType = 'unknown'
+    composeAvailable = $false
+    ports = @{}
+}
+
+try {
+    $os = Get-CimInstance Win32_OperatingSystem
+    # Do not round before threshold comparisons.
+    $measurement.usableRamGiB = $os.TotalVisibleMemorySize / 1MB
+    $measurement.freeRamGiB = $os.FreePhysicalMemory / 1MB
+} catch {
+    # Missing/failed measurements remain unknown and fail closed.
+}
+
+function Get-ExistingPathFreeGiB([string]$Path) {
+    if ([string]::IsNullOrWhiteSpace($Path)) { return $null }
+    try {
+        $item = Get-Item -LiteralPath $Path -ErrorAction Stop
+        if (-not $item.PSIsContainer -or $null -eq $item.PSDrive.Free) { return $null }
+        return $item.PSDrive.Free / 1GB
+    } catch { return $null }
+}
+$measurement.workspaceFreeGiB = Get-ExistingPathFreeGiB $workspace
+$measurement.dockerDataFreeGiB = Get-ExistingPathFreeGiB $DockerDataPath
+
+try {
+    $infoText = & docker info --format '{{json .}}' 2>$null
+    if ($LASTEXITCODE -eq 0) {
+        $info = $infoText | ConvertFrom-Json
+        $measurement.dockerEngineReachable = ($null -ne $info.ServerVersion)
+        $measurement.dockerOsType = $info.OSType
+        $measurement.dockerMemoryMiB = $info.MemTotal / 1MB
+    }
+    & docker compose version 1>$null 2>$null
+    $measurement.composeAvailable = ($LASTEXITCODE -eq 0)
+} catch {
+    # Do not print raw Docker info (could contain unrelated local configuration).
+}
+
+foreach ($port in @(3000, 3001, 3002, 3003, 3004, 5672, 15672)) {
+    $listener = $null
+    try {
+        $listener = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Loopback, $port)
+        $listener.Server.ExclusiveAddressUse = $true
+        $listener.Start()
+        $measurement.ports["$port"] = $true
+    } catch {
+        $measurement.ports["$port"] = $false
+    } finally {
+        if ($null -ne $listener) { $listener.Stop() }
+    }
+}
+
+# Only the explicit, sanitized numeric/boolean measurements above go to Node.
+# This script never reads .env, Cloud credentials or Docker settings.
+$measurement | ConvertTo-Json -Depth 4 -Compress | & node (Join-Path $PSScriptRoot 'preflight-policy.mjs') --profile $Profile --phase $Phase
+exit $LASTEXITCODE
diff --git a/v2/scripts/runtime-smoke.ps1 b/v2/scripts/runtime-smoke.ps1
new file mode 100644
index 0000000..fd55be4
--- /dev/null
+++ b/v2/scripts/runtime-smoke.ps1
@@ -0,0 +1,144 @@
+param(
+    [Parameter(Mandatory = $true)][string]$DockerDataPath,
+    [Parameter(Mandatory = $true)][string]$ArtifactDirectory,
+    [Parameter(Mandatory = $true)][string]$RunId
+)
+$ErrorActionPreference = 'Stop'
+if ($RunId -notmatch '^[a-z0-9-]+$') { throw 'Invalid test RunId.' }
+$root = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
+$compose = Join-Path $root 'infra/compose.yaml'
+$project = "gmf64-$RunId"
+$out = Join-Path $root "reports/$RunId"
+if (Test-Path $out) { throw 'Existing report directory; refusing overwrite.' }
+if (@(& docker ps --all --quiet --filter "label=com.docker.compose.project=$project").Count -gt 0) {
+    throw 'Test project already exists; refusing to touch existing containers/data.'
+}
+if (@(Get-CimInstance Win32_Process -Filter "Name='node.exe'").Count -gt 0) {
+    throw 'Windows Node processes present; classify duplicates before test.'
+}
+$pf = & (Join-Path $PSScriptRoot 'preflight.ps1') -Profile demo-lite -Phase runtime -DockerDataPath $DockerDataPath | ConvertFrom-Json
+if ($pf.status -ne 'pass') { throw 'Runtime budget preflight blocked.' }
+New-Item -ItemType Directory -Path $out | Out-Null
+$pf | ConvertTo-Json -Depth 10 | Set-Content (Join-Path $out 'preflight.json')
+$env:GMF_ARTIFACT_DIR = (Resolve-Path $ArtifactDirectory).Path
+$env:COMPOSE_PROJECT_NAME = $project
+$env:COMPOSE_DISABLE_ENV_FILE = '1'
+# Only a NEW local test-broker password; no existing credential reads or secret logs/files.
+$bytes = New-Object byte[] 32
+$rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
+$rng.GetBytes($bytes)
+$rng.Dispose()
+$env:RABBITMQ_DEMO_PASSWORD = [Convert]::ToBase64String($bytes)
+Add-Type -AssemblyName System.Net.Http
+$http = New-Object System.Net.Http.HttpClient
+$http.Timeout = [TimeSpan]::FromSeconds(5)
+$broker = New-Object System.Net.Http.HttpClient
+$broker.Timeout = [TimeSpan]::FromSeconds(5)
+$basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("gmf_demo:$($env:RABBITMQ_DEMO_PASSWORD)"))
+$broker.DefaultRequestHeaders.Authorization = [System.Net.Http.Headers.AuthenticationHeaderValue]::new('Basic', $basic)
+$samples = New-Object System.Collections.Generic.List[object]
+$checks = New-Object System.Collections.Generic.List[object]
+function Sample([string]$Phase) {
+    $os = Get-CimInstance Win32_OperatingSystem
+    $vm = @(Get-Process -Name '*vmmem*' -ErrorAction SilentlyContinue)
+    $ids = @(& docker ps --quiet --filter "label=com.docker.compose.project=$project")
+    $stats = @()
+    if ($ids.Count -gt 0) {
+        $raw = @(& docker stats --no-stream --format '{{json .}}' $ids)
+        $stats = @($raw | ForEach-Object { $_ | ConvertFrom-Json })
+    }
+    $samples.Add([pscustomobject]@{At=(Get-Date -Format o);Phase=$Phase;AvailableMiB=$os.FreePhysicalMemory/1024;
+        VmWSMiB=($vm | Measure-Object WorkingSet64 -Sum).Sum/1MB;Stats=$stats})
+    if ($os.FreePhysicalMemory/1024 -lt 1024) { throw 'Host available below 1GiB reserve; stopping only this test project.' }
+}
+function Run-Observed([string]$Phase, [string]$File, [string[]]$Arguments) {
+    $process = Start-Process -FilePath $File -ArgumentList $Arguments -PassThru -NoNewWindow -RedirectStandardOutput (Join-Path $out "$Phase.stdout.log") -RedirectStandardError (Join-Path $out "$Phase.stderr.log")
+    $null = $process.Handle
+    do {
+        Sample $Phase
+        if ($process.HasExited) { break }
+        Start-Sleep -Seconds 1
+    } while ($true)
+    $process.WaitForExit()
+    if ($null -eq $process.ExitCode -or $process.ExitCode -ne 0) { throw "$Phase failed; see phase logs (no credentials echoed)." }
+}
+function Get-Local([string]$Path) {
+    $response = $http.GetAsync($Path).Result
+    if ($null -eq $response) { throw 'Local HTTP connection failed.' }
+    return [pscustomobject]@{Status=[int]$response.StatusCode;Body=$response.Content.ReadAsStringAsync().Result}
+}
+function Smoke([string]$Phase) {
+    foreach ($entry in @(@('web',3000,'/api/health'),@('gateway',3001,'/health'),@('catalog',3002,'/health'),@('community',3003,'/health'),@('notification',3004,'/health'))) {
+        $name = $entry[0]; $base = "http://127.0.0.1:$($entry[1])"
+        $live = Get-Local "$base$($entry[2])/live"
+        $body = $live.Body | ConvertFrom-Json
+        if ($live.Status -ne 200 -or $body.service -ne $name -or $body.status -ne 'alive') { throw "Invalid liveness $name." }
+        $ready = Get-Local "$base$($entry[2])/ready"
+        if ($ready.Status -ne 503 -or ($ready.Body | ConvertFrom-Json).checks[0].status -ne 'not-implemented') { throw "Readiness must honestly remain unavailable for $name." }
+        if ((Get-Local "$base/api/v1/me").Status -ne 404) { throw "Unexpected business endpoint $name." }
+        $checks.Add([pscustomobject]@{Phase=$Phase;Service=$name;Live=200;Ready=503;Business=404})
+    }
+    $page = Get-Local 'http://127.0.0.1:3000/'
+    if ($page.Status -ne 200 -or -not $page.Body.Contains('GrabMeFood V2')) { throw 'Diagnostic Web page failed.' }
+}
+function Broker-Request([string]$Method, [string]$Path, [string]$Json) {
+    if ($Method -eq 'GET') { $response = $broker.GetAsync("http://127.0.0.1:15672$Path").Result }
+    else {
+        $content = [System.Net.Http.StringContent]::new($Json, [Text.Encoding]::UTF8, 'application/json')
+        if ($Method -eq 'PUT') { $response = $broker.PutAsync("http://127.0.0.1:15672$Path", $content).Result }
+        else { $response = $broker.PostAsync("http://127.0.0.1:15672$Path", $content).Result }
+    }
+    if ($null -eq $response -or -not $response.IsSuccessStatusCode) { throw 'Local test broker request failed (no credential output).' }
+    return $response.Content.ReadAsStringAsync().Result
+}
+try {
+    $images = Get-Content (Join-Path $root 'infra/image-proposal.json') -Raw | ConvertFrom-Json
+    if ($images.status -ne 'owner-approved') { throw 'Image approval missing.' }
+    $rabbit = "$($images.rabbitmq.reference)@$($images.rabbitmq.indexDigest)"
+    Run-Observed 'broker-pull' 'docker' @('pull','--platform','linux/amd64',$rabbit)
+    Run-Observed 'startup' 'powershell.exe' @('-NoProfile','-File',(Join-Path $PSScriptRoot 'start-demo.ps1'),'-DockerDataPath',$DockerDataPath,'-ScaffoldOnly')
+    Smoke 'all-six-started'
+    $until = (Get-Date).AddSeconds(60)
+    do { Sample 'all-six-stability'; Smoke 'all-six-stability'; Start-Sleep -Seconds 3 } while ((Get-Date) -lt $until)
+    $null = Broker-Request 'PUT' '/api/queues/%2F/gmf64_persistence' '{"durable":true,"auto_delete":false,"arguments":{}}'
+    $published = Broker-Request 'POST' '/api/exchanges/%2F/amq.default/publish' '{"properties":{"delivery_mode":2},"routing_key":"gmf64_persistence","payload":"INERT_GMF64_PERSISTENCE_CANARY","payload_encoding":"string"}'
+    if (-not ($published | ConvertFrom-Json).routed) { throw 'Test message was not routed.' }
+    $beforeStop = @()
+    foreach ($id in @(& docker ps --quiet --filter "label=com.docker.compose.project=$project")) {
+        $state = (& docker inspect --format '{"name":{{json .Name}},"oom":{{json .State.OOMKilled}},"restarts":{{.RestartCount}},"health":{{json .State.Health.Status}}}' $id) | ConvertFrom-Json
+        if ($state.oom -or $state.restarts -ne 0 -or $state.health -ne 'healthy') { throw 'Pre-stop runtime health/OOM/restart failure.' }
+        $peak = & docker exec $id cat /sys/fs/cgroup/memory.peak
+        $state | Add-Member -NotePropertyName CgroupPeakBytes -NotePropertyValue ($peak -join '')
+        $beforeStop += $state
+    }
+    if ($beforeStop.Count -ne 6) { throw 'Expected six containers before stop.' }
+    $beforeStop | ConvertTo-Json | Set-Content (Join-Path $out 'containers-before-stop.json')
+    Run-Observed 'stop' 'docker' @('compose','-p',$project,'-f',$compose,'stop','--timeout','30')
+    $stopped = @(& docker ps --quiet --filter "label=com.docker.compose.project=$project")
+    if ($stopped.Count -ne 0) { throw 'Project did not stop cleanly.' }
+    Run-Observed 'restart' 'docker' @('compose','-p',$project,'-f',$compose,'start','--wait','--wait-timeout','120')
+    Smoke 'after-restart'
+    $messages = @(Broker-Request 'POST' '/api/queues/%2F/gmf64_persistence/get' '{"count":1,"ackmode":"ack_requeue_true","encoding":"auto","truncate":256}' | ConvertFrom-Json)
+    if ($messages.Count -ne 1 -or $messages[0].payload -ne 'INERT_GMF64_PERSISTENCE_CANARY') { throw 'Durable message did not survive stop/start.' }
+    $ids = @(& docker ps --quiet --filter "label=com.docker.compose.project=$project")
+    if ($ids.Count -ne 6) { throw 'Expected all six containers simultaneously running.' }
+    $states = @()
+    foreach ($id in $ids) {
+        $selected = (& docker inspect --format '{"name":{{json .Name}},"oom":{{json .State.OOMKilled}},"restarts":{{.RestartCount}},"memory":{{.HostConfig.Memory}},"memorySwap":{{.HostConfig.MemorySwap}},"health":{{json .State.Health.Status}}}' $id) | ConvertFrom-Json
+        if ($selected.oom -or $selected.restarts -ne 0 -or $selected.health -ne 'healthy' -or $selected.memory -ne $selected.memorySwap) { throw 'OOM/restart/health/swap failure.' }
+        $peak = & docker exec $id cat /sys/fs/cgroup/memory.peak
+        $selected | Add-Member -NotePropertyName CgroupPeakBytes -NotePropertyValue ($peak -join '')
+        $states += $selected
+    }
+    $states | ConvertTo-Json | Set-Content (Join-Path $out 'containers.json')
+    [pscustomobject]@{Project=$project;SimultaneousContainers=6;StabilitySeconds=60;Persistence='pass';Scope='scaffold-not-Cloud-or-product';Status='pass'} | ConvertTo-Json | Set-Content (Join-Path $out 'result.json')
+    Write-Output 'PASS: six simultaneous healthy scaffold containers, smoke200/503/404, 60s window, stop/start, durable broker message. Cloud/business unverified.'
+} finally {
+    $samples | ConvertTo-Json -Depth 8 | Set-Content (Join-Path $out 'measurements.json')
+    $checks | ConvertTo-Json | Set-Content (Join-Path $out 'http-checks.json')
+    # Leave data/container definitions intact. Only gracefully stop our fresh test project.
+    $stop = Start-Process -FilePath docker -ArgumentList @('compose','-p',$project,'-f',$compose,'stop','--timeout','30') -Wait -PassThru -NoNewWindow -RedirectStandardOutput (Join-Path $out 'final-stop.stdout.log') -RedirectStandardError (Join-Path $out 'final-stop.stderr.log')
+    if ($stop.ExitCode -ne 0) { Write-Warning 'Test project may still be running; no forced cleanup attempted.' }
+    $http.Dispose(); $broker.Dispose()
+    $env:RABBITMQ_DEMO_PASSWORD = $null
+}
