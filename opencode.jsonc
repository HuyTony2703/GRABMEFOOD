{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=bdhavbwmxbttymerizvx&read_only=true&features=docs%2Cdatabase%2Cdevelopment"
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://opencode.ai/docs/*", "effect": "allow" },
    { "action": "skill", "resource": "opencode", "effect": "allow" },
    { "action": "execute", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "C:/Users/HUY/AppData/Local/Temp/opencode/*", "effect": "allow" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "allow" },
    { "action": "edit", "resource": "docs/permissions.md", "effect": "allow" },
    { "action": "edit", "resource": "docs/maintenance/SCRUM-46-validation.md", "effect": "allow" },
    { "action": "edit", "resource": "docs/workflows/bug-regression.md", "effect": "allow" },
    { "action": "edit", "resource": "docs/workflows/adr.md", "effect": "allow" },
    { "action": "edit", "resource": "docs/templates/bug-record.md", "effect": "allow" },
    { "action": "edit", "resource": "docs/templates/adr.md", "effect": "allow" },
    { "action": "edit", "resource": "scripts/check-guardrails.mjs", "effect": "allow" },
    { "action": "edit", "resource": "tests/contracts/guardrails.test.mjs", "effect": "allow" },
    { "action": "edit", "resource": "specs/003-grabmefood-v2/validation.md", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck", "effect": "allow" },
    { "action": "shell", "resource": "npm run check:structure", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/check-guardrails.mjs", "effect": "allow" },
    { "action": "shell", "resource": "node specs/003-grabmefood-v2/validate.mjs", "effect": "allow" },
    { "action": "shell", "resource": "opencode --version", "effect": "allow" },
    { "action": "shell", "resource": "opencode api get /api/info", "effect": "allow" },
    { "action": "shell", "resource": "opencode api get /api/config", "effect": "allow" },
    { "action": "atlassian_getJiraIssue", "resource": "*", "effect": "allow" },
    { "action": "atlassian_searchJiraIssuesUsingJql", "resource": "*", "effect": "allow" },
    { "action": "atlassian_executeRead", "resource": "*", "effect": "allow" },
    { "action": "supabase_*", "resource": "*", "effect": "deny" },
    { "action": "supabase_search_docs", "resource": "*", "effect": "allow" },
    { "action": "supabase_get_project_url", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_tables", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_extensions", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_migrations", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".opencode/permission-canary.txt", "effect": "deny" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "edit:.opencode/permission-canary.txt", "effect": "deny" }
  ]
}
